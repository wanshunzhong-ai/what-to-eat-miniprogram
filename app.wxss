/* app.wxss - 全局样式与主题 */
page {
  --bg: #FFF7F1;
  --card: #FFFFFF;
  --primary: #FF6B35;
  --primary-dark: #E8531C;
  --primary-soft: #FFEDE3;
  --accent: #FFB800;
  --text: #2B2622;
  --text-sub: #8C8177;
  --text-light: #B6ACA3;
  --line: #F2E7DE;
  --green: #34C77B;
  --shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.10);

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

.page-wrap {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  padding: 32rpx;
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #FF8A4C 0%, #FF5A1F 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(255, 90, 31, 0.32);
}
.btn-primary::after { border: none; }

.btn-primary.btn-disabled {
  background: #E6DCD4;
  color: #fff;
  box-shadow: none;
}

.btn-ghost {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 30rpx;
  text-align: center;
  border: none;
}
.btn-ghost::after { border: none; }

/* 小标签 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.chip.chip-plain {
  background: #F6F1EC;
  color: var(--text-sub);
}
.chip.chip-spicy {
  background: #FFECEC;
  color: #E53935;
}

/* 通用文本 */
.title-lg { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.title { font-size: 34rpx; font-weight: 700; }
.sub { color: var(--text-sub); font-size: 26rpx; }
.muted { color: var(--text-light); font-size: 24rpx; }

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  margin: 40rpx 0 24rpx;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--primary);
  margin-right: 16rpx;
}

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-light);
}
.empty .empty-emoji { font-size: 96rpx; display: block; margin-bottom: 24rpx; }

/* 安全区 */
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
