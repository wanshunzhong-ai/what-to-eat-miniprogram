<block wx:if="{{result}}">
  <view class="page-wrap">
    <!-- 头部：浅暖渐变卡，橙色只做点缀 -->
    <view class="result-hero anim-up">
      <view class="rh-label">今天为你推荐</view>
      <view class="rh-title">{{result.people}} 人 · {{result.mealLabel}}</view>
      <view class="rh-tags">
        <text class="chip">{{result.city.name}}</text>
        <text class="chip" wx:for="{{result.cuisines}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="rh-summary">共 {{result.count}} 道 · 其中最费时的一道约 {{result.totalTime}} 分钟</view>
    </view>

    <!-- 这一桌的配比建议 -->
    <view class="plan-card anim-up d1">
      <view class="plan-row">
        <text class="plan-title">这一桌的配比</text>
        <text class="plan-text">{{result.menuText}}</text>
      </view>
      <view class="plan-tip">{{result.menuTip}}</view>
    </view>

    <!-- 菜品列表 -->
    <view
      class="dish-card"
      wx:for="{{result.dishes}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="hv-card"
      bindtap="onDish"
    >
      <view class="dish-emoji">{{item.emoji}}</view>
      <view class="dish-body">
        <view class="dish-top">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-cat">{{item.category}}</text>
        </view>
        <view class="dish-desc">{{item.desc}}</view>
        <view class="dish-meta">
          <text class="meta-item">⏱ {{item.time}} 分钟</text>
          <text class="meta-item">👥 {{result.people}} 人份</text>
          <text class="meta-item {{item.spicy > 0 ? 'spicy' : ''}}">{{item.spicyText}}</text>
        </view>
        <view class="dish-ings">{{item.ingPreview}}</view>
      </view>
      <view class="dish-arrow">›</view>
    </view>

    <!-- 操作：三个次级动作一行，分享单独整行做主视觉 -->
    <view class="action-grid">
      <view class="act-btn" hover-class="hv-soft" bindtap="onChange">
        <text class="act-ico">🔄</text>
        <text class="act-txt">换一批</text>
      </view>
      <view class="act-btn" hover-class="hv-soft" bindtap="onCopyMenu">
        <text class="act-ico">📋</text>
        <text class="act-txt">复制清单</text>
      </view>
      <view class="act-btn" hover-class="hv-soft" bindtap="onSaveMenuImage">
        <text class="act-ico">🖼️</text>
        <text class="act-txt">存成图片</text>
      </view>
    </view>
    <button class="btn-primary share-btn" open-type="share">📤 分享给同吃的朋友</button>
    <view class="share-hint">分享出去的是这一桌的菜单，朋友点开就能看到，不用截图。</view>

    <!-- 本地人气美食 -->
    <view class="section-title">{{result.city.name}}必吃 · 本地人气</view>
    <view class="local-list">
      <view class="local-item" wx:for="{{result.localFoods}}" wx:key="name">
        <text class="local-emoji">{{item.emoji}}</text>
        <view class="local-body">
          <view class="local-name">{{item.name}}</view>
          <view class="local-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
    <view class="nearby-note">
      💡 想直接吃现成的？打开微信「搜一搜」，搜「{{result.city.name}} 附近美食」就能看到周边餐厅。
    </view>

    <!-- 返回首页 -->
    <view class="back-home" hover-class="hv" bindtap="backHome">返回首页重新选 →</view>
    <view class="safe-bottom"></view>
  </view>
</block>

<view wx:else class="empty anim-in">
  <text class="empty-emoji">🍽️</text>
  <text>还没有推荐结果</text>
  <view class="go-home" hover-class="hv" bindtap="backHome">回到首页</view>
</view>

<!-- 生成「点菜清单」图片用的画布，藏在页面背后 -->
<canvas type="2d" id="menuCanvas" class="menu-canvas"></canvas>
