/* 头部 */
.result-hero {
  background: linear-gradient(135deg, #FF8A4C 0%, #FF5A1F 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin: 0 -32rpx 32rpx;
  padding: 40rpx 44rpx 44rpx;
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(255, 90, 31, 0.28);
}
.rh-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.rh-title {
  font-size: 52rpx;
  font-weight: 700;
  margin: 8rpx 0 20rpx;
}
.rh-tags .chip {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}
.rh-summary {
  margin-top: 8rpx;
  font-size: 25rpx;
  opacity: 0.92;
}

/* 菜品卡 */
.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.08);
}
.dish-card:active {
  background: #FFFBF8;
}
.dish-emoji {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}
.dish-body {
  flex: 1;
  min-width: 0;
}
.dish-top {
  display: flex;
  align-items: center;
}
.dish-name {
  font-size: 34rpx;
  font-weight: 700;
}
.dish-cat {
  margin-left: 14rpx;
  font-size: 21rpx;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.dish-desc {
  font-size: 25rpx;
  color: var(--text-sub);
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-meta {
  display: flex;
  flex-wrap: wrap;
}
.meta-item {
  font-size: 23rpx;
  color: var(--text-light);
  margin-right: 22rpx;
}
.meta-item.spicy {
  color: #E53935;
}
.dish-ings {
  font-size: 23rpx;
  color: var(--text-light);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-arrow {
  font-size: 40rpx;
  color: var(--text-light);
  margin-left: 12rpx;
}

/* 操作 */
.action-row {
  display: flex;
  margin-top: 12rpx;
}
.action-row .btn-ghost {
  margin: 0 10rpx;
}

/* 本地人气 */
.local-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.local-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.06);
}
.local-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.local-body {
  min-width: 0;
}
.local-name {
  font-size: 28rpx;
  font-weight: 600;
}
.local-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.nearby-note {
  margin-top: 28rpx;
  background: #FFF3E9;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 24rpx;
  color: #A96A3D;
  line-height: 1.6;
}

.back-home {
  text-align: center;
  color: var(--text-sub);
  font-size: 27rpx;
  margin-top: 40rpx;
}

.go-home {
  margin-top: 26rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
