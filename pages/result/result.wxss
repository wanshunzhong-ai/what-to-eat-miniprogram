/* pages/result/result.wxss — 推荐结果 */

/* ---------- 头部：浅暖渐变卡，橙色退为点缀 ---------- */
.result-hero {
  margin: 8rpx 0 28rpx;
  padding: 36rpx 36rpx 40rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, #FFF7F2 0%, #FFE9DB 100%);
  border: 1rpx solid var(--primary-line);
}
.rh-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-ink);
  letter-spacing: 1rpx;
}
.rh-title {
  margin: 10rpx 0 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}
.rh-tags {
  display: flex;
  flex-wrap: wrap;
}
.rh-tags .chip {
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink-2);
  border: 1rpx solid #F6DFD1;
}
.rh-summary {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------- 这一桌的配比 ---------- */
.plan-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
}
.plan-row {
  display: flex;
  align-items: baseline;
}
.plan-title {
  flex: none;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary-ink);
  margin-right: 16rpx;
}
.plan-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.55;
}
.plan-tip {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 10rpx;
  line-height: 1.55;
}

/* ---------- 菜品卡 ---------- */
.dish-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--sh-1);
  transition: background 0.15s;
}
.dish-emoji {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: var(--r-md);
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 22rpx;
}
.dish-body {
  flex: 1;
  min-width: 0;
}
.dish-top {
  display: flex;
  align-items: center;
}
.dish-name {
  font-size: 32rpx;
  font-weight: 600;
}
.dish-cat {
  flex: none;
  margin-left: 12rpx;
  font-size: 21rpx;
  color: var(--primary-ink);
  background: var(--primary-soft);
  border-radius: var(--r-sm);
  padding: 2rpx 12rpx;
}
.dish-desc {
  font-size: 24rpx;
  color: var(--ink-3);
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-meta {
  display: flex;
  flex-wrap: wrap;
}
.meta-item {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-right: 20rpx;
}
.meta-item.spicy {
  color: var(--danger);
}
.dish-ings {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-arrow {
  font-size: 36rpx;
  color: var(--ink-4);
  margin-left: 10rpx;
}

/* ---------- 操作区 ---------- */
.action-grid {
  display: flex;
  margin-top: 28rpx;
}
.act-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 132rpx;
  margin-right: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
}
.act-btn:last-child {
  margin-right: 0;
}
.act-ico {
  font-size: 34rpx;
  line-height: 1;
}
.act-txt {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--ink-2);
}
.share-btn {
  margin-top: 20rpx;
}
.share-hint {
  margin-top: 16rpx;
  color: var(--ink-4);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

/* ---------- 生成清单图用的隐藏画布 ---------- */
.menu-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 620px;
  height: 1100px;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}

/* ---------- 本地人气 ---------- */
.local-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.local-item {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 22rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--sh-1);
}
.local-emoji {
  font-size: 38rpx;
  margin-right: 14rpx;
}
.local-body {
  min-width: 0;
}
.local-name {
  font-size: 27rpx;
  font-weight: 600;
}
.local-desc {
  font-size: 21rpx;
  color: var(--ink-4);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.nearby-note {
  margin-top: 28rpx;
  background: var(--sunken);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.back-home {
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  margin-top: 44rpx;
  padding: 16rpx;
}

/* ---------- 空态 ---------- */
.go-home {
  display: inline-block;
  margin-top: 26rpx;
  padding: 18rpx 52rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 28rpx;
}
