/* pages/index/index.wxss — 首页 */

/* 给吸底 CTA 让出高度，避免最后一个分区被压住 */
.page-wrap.has-dock {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部问候 ---------- */
.hero {
  padding: 28rpx 6rpx 34rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}
.hero-sub {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* ---------- 城市卡 ---------- */
.city-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}
.city-left {
  display: flex;
  align-items: center;
  min-width: 0;
}
.city-pin {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: var(--r-md);
  background: var(--sunken);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}
.city-pin.pin-on {
  background: var(--primary-soft);
}
.city-text {
  min-width: 0;
}
.city-name {
  font-size: 34rpx;
  font-weight: 600;
}
.city-desc {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.city-action {
  flex: none;
  padding-left: 16rpx;
  font-size: 26rpx;
  color: var(--primary-ink);
  font-weight: 500;
}

.tip-line {
  font-size: 23rpx;
  color: var(--ink-4);
  margin-top: 14rpx;
  padding-left: 6rpx;
  line-height: 1.5;
}

/* ---------- 吃饭方式 ---------- */
.mode-switch {
  display: flex;
  margin-top: 32rpx;
  background: var(--sunken);
  border-radius: var(--r-lg);
  padding: 8rpx;
}
.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 12rpx;
  border-radius: var(--r-md);
  transition: background 0.2s, box-shadow 0.2s;
}
.mode-item.mode-on {
  background: var(--card);
  box-shadow: var(--sh-1);
}
.mode-emoji {
  font-size: 38rpx;
  margin-right: 14rpx;
}
.mode-text {
  display: flex;
  flex-direction: column;
}
.mode-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-3);
  line-height: 1.3;
}
.mode-item.mode-on .mode-label {
  color: var(--ink);
}
.mode-desc {
  font-size: 21rpx;
  color: var(--ink-4);
  line-height: 1.3;
}

/* ---------- 人数步进器 ---------- */
.people-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 8rpx;
  padding: 0 4rpx;
}
.ps-tip {
  font-size: 24rpx;
  color: var(--ink-4);
}
.ps-ctrl {
  display: flex;
  align-items: center;
  background: var(--sunken);
  border-radius: var(--r-pill);
  padding: 6rpx;
}
.ps-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--card);
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: var(--sh-1);
}
.ps-value {
  min-width: 128rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 这一桌怎么配 ---------- */
.menu-card {
  padding: 26rpx 28rpx;
}
.mc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.mc-title {
  font-size: 30rpx;
  font-weight: 600;
}
.mc-count {
  font-size: 24rpx;
  color: var(--primary-ink);
  font-weight: 600;
}
.mc-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.mc-tag {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  font-size: 23rpx;
  margin: 0 12rpx 12rpx 0;
  background: var(--sunken);
  color: var(--ink-2);
}
.mc-tag.tag-cold   { background: #EDF4FD; color: #2563A8; }
.mc-tag.tag-meat   { background: #FEEFE8; color: #B4471F; }
.mc-tag.tag-veg    { background: #EBF7EE; color: #26703A; }
.mc-tag.tag-soup   { background: #FDF3E2; color: #94620F; }
.mc-tag.tag-snack  { background: #FDF0F4; color: #A5375C; }
.mc-tag.tag-light  { background: #EAF5F2; color: #256B60; }
.mc-tag.tag-staple { background: #F1EEFB; color: #53439C; }
.mc-text {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.mc-tip {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 12rpx;
  line-height: 1.55;
}

/* ---------- 口味偏好 ---------- */
.pref-card {
  padding: 6rpx 28rpx;
}
.pref-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pref-row-last {
  border-bottom: none;
}
.pref-label {
  width: 132rpx;
  flex: none;
  color: var(--ink-2);
  font-size: 27rpx;
}
.pref-switch {
  transform: scale(0.8);
  transform-origin: left center;
}
.pref-note {
  font-size: 22rpx;
  color: var(--ink-4);
  padding: 4rpx 0 20rpx;
  line-height: 1.55;
}

/* ---------- 次级入口 ---------- */
.footer-links {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}
.footer-link {
  color: var(--ink-3);
  font-size: 25rpx;
  padding: 14rpx 26rpx;
}

/* ---------- 吸底 CTA ---------- */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 246, 247, 0.95);
  border-top: 1rpx solid var(--line);
}
.dock-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
