.page-wrap {
  padding-top: 24rpx;
}

/* 顶部问候 */
.hero {
  padding: 20rpx 8rpx 28rpx;
}
.hero-title {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 27rpx;
}

/* 城市卡 */
.city-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}
.city-left {
  display: flex;
  align-items: center;
}
.city-pin {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #F6F1EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 22rpx;
}
.city-pin.pin-on {
  background: var(--primary-soft);
}
.city-name {
  font-size: 36rpx;
  font-weight: 700;
}
.city-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.city-action {
  font-size: 27rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.tip-line {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 16rpx;
  padding-left: 12rpx;
}

/* 选择 chip */
.chip-scroll {
  white-space: nowrap;
  width: 100%;
}
.chip-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}
.chip-row.wrap {
  flex-wrap: wrap;
}
.pick-chip {
  flex: none;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 30rpx;
  border-radius: 33rpx;
  background: #F6F1EC;
  color: #6B615A;
  font-size: 28rpx;
  margin: 0 16rpx 16rpx 0;
  transition: all .15s;
}
.pick-chip.sm {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.pick-on {
  background: linear-gradient(135deg, #FF8A4C 0%, #FF5A1F 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 31, 0.28);
}

/* 偏好卡 */
.pref-card {
  padding: 12rpx 28rpx;
}
.pref-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pref-row:last-child {
  border-bottom: none;
}
.pref-label {
  width: 140rpx;
  flex: none;
  color: var(--text-sub);
  font-size: 27rpx;
}
.pref-switch {
  transform: scale(0.85);
  transform-origin: left center;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 主按钮 */
.start-wrap {
  margin-top: 48rpx;
}
.start-hint {
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
  margin-top: 20rpx;
}

/* 底部入口 */
.footer-links {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}
.footer-link {
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
}
