/* pages/city/city.wxss — 选择城市 */

/* ---------- 搜索 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  padding: 0 28rpx;
  box-shadow: var(--sh-1);
  margin-top: 8rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.ph {
  color: var(--ink-4);
}

/* ---------- 定位按钮（次级动作，白底描边） ---------- */
.locate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: var(--r-pill);
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 500;
  transition: background 0.15s;
}
.locate-emoji {
  margin-right: 12rpx;
}

/* ---------- 离你最近 ---------- */
.near-hint {
  font-size: 22rpx;
  color: var(--ink-4);
  margin: -8rpx 0 16rpx;
  line-height: 1.5;
}
.near-scroll {
  white-space: nowrap;
}
.near-row {
  display: inline-flex;
  padding-bottom: 6rpx;
}
.near-item {
  display: inline-block;
  min-width: 152rpx;
  margin-right: 14rpx;
  padding: 20rpx 22rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  text-align: center;
  transition: background 0.15s, border-color 0.15s;
}
.near-item.near-on {
  border-color: var(--primary);
  background: var(--primary-soft);
}
.ni-name {
  font-size: 28rpx;
  font-weight: 600;
}
.ni-dist {
  font-size: 21rpx;
  color: var(--primary-ink);
  margin-top: 4rpx;
}
.ni-cuisine {
  font-size: 20rpx;
  color: var(--ink-4);
  margin-top: 2rpx;
}

/* ---------- 热门城市 ---------- */
.hot-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.hot-item {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 22rpx 8rpx;
  text-align: center;
  box-shadow: var(--sh-1);
  transition: background 0.15s, border-color 0.15s;
}
/* 选中态从「整块渐变」改为浅底 + 描边，和全局选中语言保持一致 */
.hot-item.hot-on {
  background: var(--primary-soft);
  border-color: var(--primary-line);
}
.hot-name {
  font-size: 27rpx;
  font-weight: 600;
}
.hot-item.hot-on .hot-name {
  color: var(--primary-ink);
}
.hot-cuisine {
  font-size: 20rpx;
  color: var(--ink-4);
  margin-top: 4rpx;
}

/* ---------- 城市列表 ---------- */
.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  margin-bottom: 12rpx;
  box-shadow: var(--sh-1);
  transition: background 0.15s;
}
.ci-left {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.ci-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 14rpx;
}
.ci-prov {
  font-size: 22rpx;
  color: var(--ink-4);
}
.ci-cuisine {
  font-size: 24rpx;
  color: var(--ink-3);
}
.city-foot {
  text-align: center;
  color: var(--ink-4);
  font-size: 23rpx;
  margin: 30rpx 0 10rpx;
}
