/* pages/detail/detail.wxss — 菜品详情 */

/* ---------- 头部：浅暖渐变，与结果页同一套语言 ---------- */
.d-hero {
  margin-top: 16rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, #FFF7F2 0%, #FFE9DB 100%);
  border: 1rpx solid var(--primary-line);
  text-align: center;
}
.d-emoji {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  margin: 0 auto 20rpx;
  border-radius: var(--r-xl);
  background: #fff;
  font-size: 72rpx;
  box-shadow: var(--sh-1);
}
.d-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.d-tags {
  margin-top: 16rpx;
}
.d-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.d-meta .dot {
  margin: 0 12rpx;
  color: var(--ink-4);
}
.d-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ---------- 食材 ---------- */
.ing-card {
  padding: 8rpx 28rpx;
}
.ing-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ing-item:last-child {
  border-bottom: none;
}
.ing-name {
  font-size: 28rpx;
  color: var(--ink);
}
.ing-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-ink);
}
.ing-amount.small {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-3);
}

/* ---------- 做法步骤 ---------- */
.steps {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 10rpx 28rpx;
  box-shadow: var(--sh-1);
}
.step-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.step-item:last-child {
  border-bottom: none;
}
.step-no {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-ink);
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
}
.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---------- 小贴士 ---------- */
.tip-card {
  margin-top: 32rpx;
  background: var(--primary-soft);
  border-radius: var(--r-md);
  padding: 26rpx 28rpx;
}
.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-ink);
}
.tip-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8A4A2A;
  line-height: 1.6;
}

/* ---------- 操作 ---------- */
.action-row {
  display: flex;
  margin-top: 44rpx;
}
.action-row .btn-ghost {
  margin: 0 10rpx;
}
