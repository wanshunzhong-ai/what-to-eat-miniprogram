.hero {
  padding: 24rpx 8rpx 20rpx;
}
.hero-title {
  font-size: 50rpx;
  font-weight: 700;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 27rpx;
}

/* 偏好 */
.pref-card {
  padding: 12rpx 28rpx;
}
.pref-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pref-row:last-child {
  border-bottom: none;
}
.pref-label {
  width: 140rpx;
  flex: none;
  color: var(--text-sub);
  font-size: 27rpx;
}
.pref-switch {
  transform: scale(0.85);
  transform-origin: left center;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 分区标题（带右侧操作） */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 0 22rpx;
}
.section-head .section-title {
  margin: 0;
}
.clear-btn {
  font-size: 25rpx;
  color: var(--text-sub);
  padding: 8rpx 16rpx;
}

.mini-empty {
  font-size: 25rpx;
  color: var(--text-light);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.05);
}

/* 收藏分区切换 */
.tab-bar {
  display: flex;
  background: #F6F1EC;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: var(--text-sub);
  padding: 16rpx 0;
  border-radius: 18rpx;
  transition: all .18s;
}
.tab-item.tab-on {
  background: #fff;
  color: var(--primary-dark);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.14);
}

/* 收藏 */
.fav-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 22rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.05);
}
.fav-item.shop-item {
  align-items: flex-start;
}
.fav-emoji {
  font-size: 46rpx;
  margin-right: 22rpx;
}
.fav-body {
  flex: 1;
  min-width: 0;
}
.fav-name {
  font-size: 31rpx;
  font-weight: 600;
}
.fav-sub {
  font-size: 23rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}
.fav-addr {
  font-size: 23rpx;
  color: var(--text-light);
  margin-top: 4rpx;
  line-height: 1.45;
}
.fav-arrow {
  font-size: 40rpx;
  color: var(--text-light);
}

/* 店铺收藏的操作行 */
.shop-acts {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.shop-act {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
  padding: 8rpx 24rpx 8rpx 0;
  margin-right: 10rpx;
}
.shop-act.act-weak {
  color: var(--text-light);
  font-weight: 400;
}

/* 历史 */
.his-item {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.05);
}
.his-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.his-left {
  display: flex;
  align-items: center;
  min-width: 0;
}
.his-kind {
  font-size: 21rpx;
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
  margin-right: 14rpx;
  flex: none;
}
.his-kind.kind-cook {
  background: var(--primary-soft);
  color: var(--primary-dark);
}
.his-kind.kind-takeout {
  background: #E8F4FF;
  color: #1F7AD8;
}
.his-title {
  font-size: 30rpx;
  font-weight: 700;
}
.his-time {
  font-size: 23rpx;
  color: var(--text-light);
}
.his-city {
  font-size: 24rpx;
  color: var(--primary-dark);
  margin-top: 8rpx;
}
.his-dishes {
  font-size: 25rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 菜品库卡片 */
.lib-card {
  padding: 20rpx 28rpx 24rpx;
}
.lib-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.lib-label {
  color: var(--text-sub);
  font-size: 27rpx;
}
.lib-value {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 600;
}
.lib-tip {
  margin-top: 18rpx;
  color: var(--text-light);
  font-size: 23rpx;
  line-height: 1.6;
}
.lib-btn {
  margin-top: 22rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 28rpx;
  font-weight: 600;
}
.lib-btn-busy {
  opacity: 0.6;
}
