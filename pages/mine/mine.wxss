/* pages/mine/mine.wxss — 我的 */

/* ---------- 页头 ---------- */
.hero {
  padding: 24rpx 6rpx 20rpx;
}
.hero-title {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* ---------- 分区标题（带右侧操作） ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 0 22rpx;
}
.section-head .section-title {
  margin: 0;
}
.clear-btn {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 8rpx 16rpx;
}

.mini-empty {
  font-size: 24rpx;
  color: var(--ink-4);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 44rpx 32rpx;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 收藏分区切换 ---------- */
.tab-bar {
  display: flex;
  background: var(--sunken);
  border-radius: var(--r-md);
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 16rpx 0;
  border-radius: var(--r-sm);
  transition: background 0.18s, color 0.18s;
}
.tab-item.tab-on {
  background: var(--card);
  color: var(--ink);
  font-weight: 600;
  box-shadow: var(--sh-1);
}

/* ---------- 收藏项 ---------- */
.fav-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--sh-1);
  transition: background 0.15s;
}
.fav-item.shop-item {
  align-items: flex-start;
}
.fav-emoji {
  font-size: 42rpx;
  margin-right: 20rpx;
}
.fav-body {
  flex: 1;
  min-width: 0;
}
.fav-name {
  font-size: 30rpx;
  font-weight: 600;
}
.fav-sub {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 4rpx;
}
.fav-addr {
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 4rpx;
  line-height: 1.45;
}
.fav-deli {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  line-height: 1.45;
}
.fav-out {
  color: var(--danger);
}
.fav-arrow {
  font-size: 34rpx;
  color: var(--ink-4);
}

/* 店铺收藏的操作行 */
.shop-acts {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.shop-act {
  font-size: 23rpx;
  color: var(--primary-ink);
  font-weight: 500;
  padding: 8rpx 24rpx 8rpx 0;
  margin-right: 10rpx;
}
.shop-act.act-weak {
  color: var(--ink-4);
  font-weight: 400;
}

/* ---------- 历史 ---------- */
.his-item {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--sh-1);
  transition: background 0.15s;
}
.his-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.his-left {
  display: flex;
  align-items: center;
  min-width: 0;
}
.his-kind {
  font-size: 21rpx;
  border-radius: var(--r-pill);
  padding: 4rpx 14rpx;
  margin-right: 14rpx;
  flex: none;
}
.his-kind.kind-cook {
  background: var(--primary-soft);
  color: var(--primary-ink);
}
.his-kind.kind-takeout {
  background: var(--blue-soft);
  color: #1D6FC4;
}
.his-title {
  font-size: 29rpx;
  font-weight: 600;
}
.his-time {
  font-size: 22rpx;
  color: var(--ink-4);
}
.his-city {
  font-size: 23rpx;
  color: var(--primary-ink);
  margin-top: 8rpx;
}
.his-dishes {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ---------- 信息卡（菜品库 / 云端同步共用） ---------- */
.lib-card {
  padding: 16rpx 28rpx 24rpx;
}
.sync-card {
  padding: 16rpx 28rpx 24rpx;
}
.lib-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.lib-row:last-of-type {
  border-bottom: none;
}
.lib-label {
  color: var(--ink-3);
  font-size: 26rpx;
}
.lib-value {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}
.lib-tip {
  margin-top: 18rpx;
  color: var(--ink-4);
  font-size: 22rpx;
  line-height: 1.6;
}
.lib-btn {
  margin-top: 22rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  border-radius: var(--r-pill);
  background: var(--sunken);
  color: var(--ink-2);
  font-size: 27rpx;
  font-weight: 500;
  transition: background 0.15s;
}
.lib-btn-busy {
  opacity: 0.55;
}

/* 同步状态圆点 */
.sync-state {
  display: flex;
  align-items: center;
}
.state-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot-ok {
  background: var(--green);
}
.dot-bad {
  background: var(--danger);
}
.sync-bad {
  color: var(--danger);
  font-weight: 600;
}
