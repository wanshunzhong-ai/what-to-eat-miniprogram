/* pages/share/share.wxss — 朋友分享的点菜清单 */

/* 与 result 页头部同一套浅暖渐变，橙色只留标签与圆点 */
.share-hero {
  margin: 8rpx 0 24rpx;
  padding: 36rpx 36rpx 40rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, #FFF7F2 0%, #FFE9DB 100%);
  border: 1rpx solid var(--primary-line);
}
.sh-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-ink);
  letter-spacing: 1rpx;
}
.sh-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}
.sh-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}
.sh-tags .chip {
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink-2);
  border: 1rpx solid #F6DFD1;
}

/* ---------- 分组 ---------- */
.group {
  margin-bottom: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 20rpx 26rpx 6rpx;
  box-shadow: var(--sh-1);
}
.group-title {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--line);
}
.gt-dot {
  color: var(--primary);
  font-size: 20rpx;
  margin-right: 12rpx;
}
.gt-count {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-4);
}
.group-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
  transition: background 0.15s;
}
.group-item:last-child {
  border-bottom: none;
}
.gi-emoji {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.gi-name {
  font-size: 28rpx;
  color: var(--ink);
}

/* ---------- 操作 ---------- */
.action-row {
  display: flex;
  margin-top: 12rpx;
}
.action-row .btn-ghost {
  margin: 0 8rpx;
}

.go-own {
  margin-top: 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--sh-primary);
}

.tip-note {
  margin-top: 22rpx;
  color: var(--ink-4);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

/* ---------- 空态 ---------- */
.empty-sub {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--ink-4);
}
.go-home {
  display: inline-block;
  margin-top: 40rpx;
  padding: 18rpx 56rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
}
