.page-wrap {
  padding-top: 24rpx;
}

/* 当前条件条 */
.cond-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.cond-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-sub);
  background: #F6F1EC;
  border-radius: 22rpx;
  padding: 8rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.cond-emoji {
  margin-right: 8rpx;
}

/* 品类 chip */
.chip-scroll {
  white-space: nowrap;
  width: 100%;
  margin-top: 10rpx;
}
.chip-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}
.chip-row.wrap {
  flex-wrap: wrap;
}
.pick-chip {
  flex: none;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 30rpx;
  border-radius: 33rpx;
  background: #F6F1EC;
  color: #6B615A;
  font-size: 28rpx;
  margin: 0 16rpx 16rpx 0;
  transition: all .15s;
}
.pick-chip.sm {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
}
.pick-chip.xs {
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.pick-on {
  background: linear-gradient(135deg, #FF8A4C 0%, #FF5A1F 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 31, 0.28);
}

/* 预算行 */
.budget-row {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.budget-label {
  flex: none;
  width: 130rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 54rpx;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 结果表头 */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
}
.list-count {
  font-size: 32rpx;
  font-weight: 700;
}
.list-radius {
  font-size: 23rpx;
  color: var(--text-light);
}

/* 店铺卡片 */
.shop-card {
  background: var(--card);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
  padding: 26rpx 28rpx 20rpx;
  margin-bottom: 22rpx;
}
.shop-top {
  display: flex;
  align-items: flex-start;
}
.shop-emoji {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
}
.shop-main {
  flex: 1;
  min-width: 0;
}
.shop-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}
.shop-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.mini-chip {
  font-size: 22rpx;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: 18rpx;
  padding: 4rpx 16rpx;
  margin-right: 14rpx;
}
.shop-dist {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 14rpx;
}
.shop-price {
  font-size: 24rpx;
  color: var(--text-light);
}
.shop-why {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: #FFF4EC;
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  line-height: 1.45;
}
.shop-addr {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.45;
}
.shop-fav {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #D9CFC6;
  margin-left: 8rpx;
}
.shop-fav.faved {
  color: var(--accent);
}

/* 卡片底部操作 */
.shop-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.act {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

/* 未配置 Key 的提示卡 */
.notice {
  border-left: 8rpx solid var(--accent);
}
.notice-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.notice-text {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-top: 8rpx;
}
.notice-code {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-light);
  background: #F6F1EC;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}

/* 兜底人气美食 */
.food-wrap {
  display: flex;
  flex-wrap: wrap;
}
.food-chip {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 26rpx;
  box-shadow: var(--shadow);
  padding: 18rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}
.food-emoji {
  margin-right: 10rpx;
  font-size: 28rpx;
}
.food-name {
  font-size: 27rpx;
  font-weight: 600;
}

/* 空态 / 失败 */
.empty {
  text-align: center;
  padding: 110rpx 0 40rpx;
  color: var(--text-light);
}
.empty-emoji {
  font-size: 92rpx;
  display: block;
  margin-bottom: 22rpx;
}
.empty-text {
  font-size: 27rpx;
  color: var(--text-sub);
  padding: 0 40rpx;
  line-height: 1.6;
}
.retry-btn {
  width: 320rpx;
  margin: 36rpx auto 0;
}

.tip-line {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 16rpx;
  padding-left: 12rpx;
}

.more-wrap {
  margin-top: 12rpx;
}
.end-hint {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.footer-links {
  display: flex;
  justify-content: center;
  margin-top: 34rpx;
}
.footer-link {
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
}

/* 数据来源说明 */
.src-note {
  margin: -6rpx 4rpx 16rpx;
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.6;
}
